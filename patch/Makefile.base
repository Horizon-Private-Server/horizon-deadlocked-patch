EE_ELF ?= patch-11184.elf
EE_BIN ?= patch-11184.bin
EE_OBJS += common.o window.o main.o spectate.o maploader.o rpc.o config.o functions.o mapeditor.o scoreboard.o gamerules.o halftime.o freecam.o playersync.o extralocals.o macaddrs.o spmusic.o
EE_LIBS += -ldl

EE_INCS := -I../common -I../libdl/include
EE_LDFLAGS = -fno-builtin -nostdlib -nostartfiles -L. -L../libdl/lib

#EE_DEFS += -DDEBUG
#EE_DEFS += -DRELOADPATCH
#EE_DEFS += -DSCAVENGER_HUNT
#EE_DEFS += -DTWEAKERS
#EE_DEFS += -DDEV
#EE_DEFS += -DMAPEDITOR
#EE_DEFS += -DSCR_PRINT
#EE_DEFS += -DMAPDOWNLOADER
EE_DEFS += -DMAPBOOTELF
#EE_DEFS += -DTEST
#EE_DEFS += -DPINGTEST
#EE_DEFS += -DLEVELHOP
#EE_DEFS += -DQUICKCHAT
#EE_DEFS += -DNPS_INSTANTSYNC
EE_DEFS += -DRAIDS

# build test if defined
ifneq (,$(findstring -DTEST,$(EE_DEFS)))
    EE_OBJS += test.o
endif

# build scavenger hunt if defined
ifneq (,$(findstring -DSCAVENGER_HUNT,$(EE_DEFS)))
    EE_OBJS += scavengerhunt.o
endif

# build quickchat if defined
ifneq (,$(findstring -DQUICKCHAT,$(EE_DEFS)))
    EE_OBJS += quickchat.o
endif

all: $(EE_BIN) clean copy

$(EE_BIN): linkfile

define CHECK_PATCH_SIZE
	@set -eu; \
	patch_end=$$($(EE_PREFIX)nm -n "$(EE_ELF)" | awk '$$3 == "_end" { print "0x" $$1 }'); \
	test -n "$$patch_end" || { echo "ERROR: Missing patch _end symbol"; exit 1; }; \
	patch_end=$$((patch_end)); \
	patch_bytes=$$(wc -c < "$(EE_BIN)"); \
	if test "$$patch_end" -gt $$((0x000F0000)) || test "$$patch_bytes" -gt $$((0x20000)); then \
		printf 'ERROR: Patch overlaps gamemode memory at 0x000F0000 (runtime end 0x%08X, binary %d bytes)\n' "$$patch_end" "$$patch_bytes"; \
		exit 1; \
	fi; \
	printf 'Patch runtime end: 0x%08X (%d bytes free before 0x000F0000)\n' "$$patch_end" $$((0x000F0000 - patch_end))
endef

.DELETE_ON_ERROR:
.PHONY: check-size
check-size: $(EE_BIN)
	$(CHECK_PATCH_SIZE)

# Validate both base and comp builds before copying them into bin/.
copy: check-size

# print out size stats
stats:
	@echo "modules:"
	@nm --print-size --size-sort --reverse $(EE_ELF) | head -20
	@nm -n --print-size $(EE_ELF) | tail -1

clean:
	rm -f *.irx *.o

include ${CURDIR}/../Makefile.pref
include ${CURDIR}/../Makefile.eeglobal
include ${CURDIR}/../Makefile.rules
